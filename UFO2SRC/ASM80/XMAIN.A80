;**** HЛО-2. Дьяволы бездны ****
*M-
*D-
	DEFB 0
SYSINI	DEFB 28 ;systxt 28
MONINI	DEFB 1 ;1/0 в ScrBU нет/есть текст
xHACK	DEFB #7;F;если 7f, то видимое поле []
*F xLID
*F xGamedat
FONT
*B ..\data\xfont.dat
CRC3	DEFB 11
*L+
TAB100	DEFR 98
	DEFB #15,#88 ;таблица плохих секторов
*L-
*F xlib
CRC2	DEFW 0;[] -crc2
xHAC2	DEFB #D5;D6;если D6, то нет боя []
*F xlie
;--------swap-область
;*L+
*F XLIN
*F xliM
*F XLIK
*L+
*D-
	DEFR #8F3F-$
	DEFM " Область для размещения стека "
	DEFS #9000-$,#CC
*L-
*F xLI1 ;нач. уст
	ORG $
LESHA	DISP #B000
*F xLESHA
	ENDD

*P0 *********** Страница 0 ***********
	ORG #C000
ASMBL1	DISP #AB00
*F xlix
	ENDD
	ORG $
ASMBL2	DISP SwpADR
*F XLIC
*L+
	DEFB $/256,$?256 ;xlic
*L-
	ENDD
	ORG $
ASMBL3	DISP SwpADR
*F XLIF
*F XIOD
*L+
	DEFB $/256,$?256 ;xliF+xioD
*L-
	ENDD

