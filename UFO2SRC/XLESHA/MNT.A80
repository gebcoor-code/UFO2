DONEPTR DEFW	0
INIFLAG DEFS	1
DIRVECN DEFS	1
FY0	DEFS	1
FZ0	DEFS	1
DFY	DEFS	1
DFZ	DEFS	1
LNDRAW	DEFS	64
PGDRAW	DEFS	32
PTDRAW	DEFS	64
PTBUFF	DEFS	64*3
COSTBL	DEFS	128*ANGSNUM
PTTABL	DEFS	64*3 ; permanent basic pts table
RTINFO DEFS	6
SHINFO DEFS	3
FREE16	DEFS	16 ; used by ZX-MATH library
MASK	DEFS	4
CSRFLAG DEFS	1
MNGPTR	DEFW	0
FIRE	DEFB	0 ; flag indicating our fire conditions
OURENT	DEFB	2 ; entry point for our ship (0..2)
HISENT	DEFB	0 ; entry point for his ship (0..2)
RETURN	DEFB	0 ; our return parameter
HISPWR	DEFB	200
CONSTH	DEFB	32 ; decrement of his power
OURPWR	DEFB	200
CONSTO	DEFB	32 ; decrement of our power
OINIPWR DEFW	200 ; our initial power
HISCNT	DEFB	0
OURCNT	DEFB	0
REACT	DEFB	0
HBULSFT DEFS	2 ; yz of his bullets shift
ANGCNT	DEFB	0 ; angle counter used for alien shift
CODEBUF DEFS	16 ; used for code substitutions
ISSOUND DEFB	0 ; should sound appear

