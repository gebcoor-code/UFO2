CC	EQU	3

PTTAB4	DEFB	0,40,CC ;
	DEFB	0,40,256-CC
	DEFB	0,40-CC,0
	DEFB	0,40+CC,0
	DEFB	0,28,28+CC ;
	DEFB	0,28,28-CC
	DEFB	0,28-CC,28
	DEFB	0,28+CC,28
	DEFB	0,0,40+CC ;
	DEFB	0,0,40-CC
	DEFB	0,256-CC,40
	DEFB	0,CC,40
	DEFB	0,228,28+CC ;
	DEFB	0,228,28-CC
	DEFB	0,228-CC,28
	DEFB	0,228+CC,28
	DEFB	0,216,CC ;
	DEFB	0,216,256-CC
	DEFB	0,216-CC,0
	DEFB	0,216+CC,0
	DEFB	0,228,228+CC ;
