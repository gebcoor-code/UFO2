	LD	(HL),7
	LD	BC,767
	LDIR
	RET

BASEINI
BICFG1	LD	A,176
	PUSH	HL
	LD	HL,(SHIPTR)
	LD	(HL),A
	XOR	A
	INC	HL
	LD	(HL),A
	INC	HL
	LD	(HL),A
