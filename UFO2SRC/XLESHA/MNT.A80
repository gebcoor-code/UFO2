ANGSNUM EQU	33
SHDSCR	EQU	#9000
VISSCR	EQU	#4000

	ORG	#B000   ;не трогать

TAB1	DEFS 256	;ORG кратен 256
TAB2	DEFS 256	;
TAB3	DEFS 256	;
TAB4	DEFS 256	;
			;
SNOWTAB DEFS	32	;
SNOWPTR DEFS	2	;
RNDPTR	DEFS	2	;
RNDTAB	DEFS	64	;конец блока
PTSNUM	DEFB	0
LNSNUM	DEFB	0
PGSNUM	DEFB	0
PPTS	DEFW	0 ; ptr on constant pts table
PLNS	DEFW	0 ; ptr on lines table
PPGP	DEFW	0 ; ptr on ptr on polygons
ROTPTR	DEFW	0
SHIPTR	DEFW	0
SMTPTR	DEFW	0
INIPTR	DEFW	0
