	LD	E,A
	LD	(HL),A
	INC	HL
	LD	A,(HL)
	ADD	A,(IX+2)
	SUB	(IX+3)
	LD	D,A
	LD	(HL),A
	LD	A,B
	SLA	A
	SLA	A
	SLA	A
	SLA	A
	SUB	128
	LD	H,A
	LD	L,E
