	LD	IX,(MNGPTR)
	LD	(IX+25),A
	LD	HL,SM1END
	LD	(IX+13),L
	LD	(IX+14),H
	CALL	CLS
BICFG2	LD	B,20
BICYC1	PUSH	BC
	LD	HL,(ROTPTR)
	INC	HL
	INC	HL
	INC	HL
	LD	A,4
