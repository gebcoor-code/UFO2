RTINF4 DEFB	0,0,0,0,0,0
SHINF4 DEFB	0,0,0

BEGIN

CMPMOD	BIT	7,A
	JR	NZ,CM1
	CP	B
	RET
CM1	CPL
	CP	B
	CPL
	RET

CMPSGN	XOR	128
	LD	C,A
	LD	A,B
	XOR	128
	LD	B,A
	LD	A,C
	CP	B
	RET

PRSROW	IN	A,(C)
	CPL
	AND	#1F
	RET
TMO	LD	A,(KEYJOY)
	OR	A
	JR	NZ,TMOJOY
	LD	C,#FE
	LD	B,C
TMOO	CALL	PRSROW
	JR	NZ,TMOOK
	RLC	B
	JR	TMOO
TMOOK	LD	C,A
	RET
TMOJOY	CALL	CONTR
	LD	A,(CONTRB)
	OR	A
	JR	Z,TMOJOY
	RET

PRSKEY	PUSH	BC
	LD	C,#FE
	CALL	PRSROW
	POP	BC
	AND	C
	RET

DELAY	PUSH	BC
DELY3	LD	C,10
DELY2	LD	B,0
DELY1	INC	B
	JP	NZ,DELY1
	DEC	C
	JP	NZ,DELY2
	DEC	A
	JP	NZ,DELY3
	POP	BC
	RET

CONTR	PUSH	HL
	PUSH	DE
	PUSH	BC
	LD	A,(KEYJOY)
	OR	A
	JR	Z,CO1
	LD	BC,#FF1F
	CALL	PRSROW
	XOR	#1F
CO2	LD	(CONTRB),A
	POP	BC
	POP	DE
	POP	HL
	RET
CO1	LD	HL,(KEYS)
	LD	E,0
	LD	D,5
CO3	LD	C,(HL)
	INC	HL
	LD	B,(HL)
	CALL	PRSKEY
	JR	Z,CO4
	SET	5,E
CO4	RRC	E
	DEC	D
	INC	HL
	JR	NZ,CO3
	LD	A,E
	JR	CO2
KEYS	DEFW	KBR
KEYJOY	DEFB	0
CONTRB	DEFB	0
KBR	DEFW	#DF01,#DF02,#FD01,#FB01,#7F0F
INT2	DEFW	#EF08,#EF10,#EF04,#EF02,#EF01
;KUR	DEFW	#EF04,#F710,#EF10,#EF08,#EF01

RNB	DEFB	95
RNA	DEFW	1
RND	PUSH	HL
	LD	HL,(RNA)
	INC	HL
	LD	A,H
	AND	#1F
	LD	H,A
	LD	A,(RNB)
	RRCA
	XOR	(HL)
	ADD	A,C
	LD	(RNA),HL
	LD	(RNB),A
	POP	HL
	RET

MULB2	PUSH	HL	;HL*E--DE	(C)
	JR	MULENT
MULB	PUSH	HL	;L*E--DE
	LD	H,0
MULENT	LD	A,E
	LD	E,0
	LD	D,E
	JR	MMULB2
MMULB1	ADD	HL,HL
	JR	C,ENDMUL
MMULB2	OR	A
	JR	Z,ENDMUL
	RRA
	JR	NC,MMULB1
	EX	DE,HL
	ADD	HL,DE
	EX	DE,HL
	JR	MMULB1
ENDMUL	POP	HL
	RET

MUL	PUSH	HL ;HL*DE--DE
	XOR	A
	OR	D
	JR	Z,MULENT
	EX	DE,HL
	XOR	A
	OR	D
	JR	Z,MULENT
	SCF
	POP	HL
	RET

DIVB	LD	D,0 ;E/L--E (MOD in D)
DIVB2	PUSH	HL ;DE/L--E
	PUSH	BC
	LD	B,8
	EX	DE,HL
	LD	D,E
	LD	E,0
DIV1B	OR	A
	RR	D
	RR	E
	SBC	HL,DE
	JR	NC,MDIVB
	ADD	HL,DE
MDIVB	RLA
	DJNZ	DIV1B
	CPL
	LD	D,L
	LD	E,A
	POP	BC
	POP	HL
	RET

PLOT2	LD	L,D
	LD	H,TAB1/256
	LD	B,(HL)
	INC	H
	LD	C,(HL)
	INC	H
	LD	L,E
	LD	A,(HL)
	OR	C
	LD	C,A
	INC	H
	LD	E,(HL)
	LD	H,B
	LD	L,C
	LD	BC,SHDSCR-VISSCR
	OR	A
	SBC	HL,BC
	LD	A,(HL)
	XOR	E
	LD	(HL),A
	RET

LINE2	PUSH	HL; NEW line from p1(l,h) to p2(e,d)
	PUSH	DE
	PUSH	BC
	LD	B,#15
	LD	C,#1D
	LD	A,E
	SUB	L
	JR	NC,M1LI_
	NEG
	EX	DE,HL
M1LI_	LD	L,A
	LD	A,D
	SUB	H
	JR	NC,M2LI_
	NEG
	DEC	B
M2LI_	LD	H,A
	CP	L
	JR	C,M3LI_
	LD	A,B
	LD	B,C
	LD	C,A
	LD	A,H
	LD	H,L
	LD	L,A
M3LI_	LD	A,B
	LD	(dePENC),A
	LD	A,C
	LD	(inDEPC),A
	PUSH	DE
	LD	C,L
	LD	E,L
	LD	L,H
	CALL	DIVB
	LD	A,E
	LD	(simLIN+1),A
	LD	L,C
	LD	A,L
	LD	(ldLIN+1),A
	LD	A,D
	LD	(decLIN+1),A
	OR	A
	LD	B,E
	RR	B
	INC	B
	OR	A
	RR	C
	POP	DE
	INC	L
	JR	L4LI_
simLIN	LD	B,#FF
L4LI_	PUSH	DE
;------
	EXX
	POP	DE
	LD	L,D
	LD	H,TAB1/256
	LD	B,(HL)
	INC	H
	LD	C,(HL)
	INC	H
	LD	L,E
	LD	A,(HL)
	OR	C
	LD	C,A
	INC	H
	LD	L,(HL)
	LD	A,(BC)
	OR	L
	LD	(BC),A
	EXX
;-----
inDEPC	DEC	D
	DEC	L
	JR	Z,retLIN
	LD	A,C
decLIN	SUB	#02
	LD	C,A
	JR	C,ldLIN
	DJNZ	L4LI_
dePENC	DEC	E
	JR	simLIN
ldLIN	ADD	A,#FF
	LD	C,A
	JR	L4LI_
retLIN	POP	BC
	POP	DE
	POP	HL
	RET


FORMTBL ; forms rescaled cosines table
	; forms line-drawing aid table
	LD	IX,COSTBL
	LD	HL,ANGLES
	LD	B,ANGSNUM
FTCC1	PUSH	BC
	PUSH	HL
	LD	A,(HL)
	LD	E,0
	LD	B,128
FTCC2	PUSH	BC
	PUSH	AF
	PUSH	DE
	LD	L,A
	CALL	MULB
	LD	(IX),D
	INC	IX
	POP	DE
	POP	AF
	POP	BC
	INC	E
	DJNZ	FTCC2
	POP	HL
	POP	BC
	INC	HL
	DJNZ	FTCC1
	LD	HL,TAB1
	LD	C,4
	LD	A,#90
FTCC21 LD	E,8
FTCC22 PUSH	AF
	LD	B,8
FTCC23 LD	(HL),A
	INC	A
	INC	HL
	DJNZ	FTCC23
	POP	AF
	DEC	E
	JR	NZ,FTCC22
	ADD	A,8
	DEC	C
	JR	NZ,FTCC21
	LD	C,4
FTCC3	LD	E,8
